{
  "manifest_version": 3,
  "name": "Ed Staff Hours",
  "version": "0.1",
  "description": "Counts time course staff spend working on Ed.",
  "permissions": ["idle", "alarms", "storage", "scripting"],
  "host_permissions": ["https://*.edstem.org/*", "https://*.cs61a.org/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*.edstem.org/*"], "js": ["ed-banner.js"] }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
